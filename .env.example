# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is gitignored.

DATASET_PATH=data/dataset
OUTPUT_DIR=outputs
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Azure AI Foundry endpoint for the generation LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Azure OpenAI endpoint for RAGAS / citation judging
OPENAI_API_KEY=
OPENAI_BASE_URL=
EVAL_MODEL=gpt-4.1

MAX_FILES=0
INDEX_LIMIT=0
